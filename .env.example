# Data Server Configuration
# This is the URL of your existing Options Calc server with Schwab connection
DATA_SERVER_URL=http://YOUR_DATA_SERVER_IP:8000

# Server ports (unique to avoid conflicts with other projects)
HOST=0.0.0.0
PORT=8042

# Polling intervals (seconds) - conservative to avoid overloading data server
QUOTE_POLL_INTERVAL=30.0
HISTORY_POLL_INTERVAL=600.0
DIVERGENCE_SCAN_INTERVAL=120.0

# Divergence thresholds
CORRELATION_BREAKDOWN_THRESHOLD=2.0
RS_CHANGE_THRESHOLD=5.0
