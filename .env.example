# Wingman Environment Variables
# Copy to .env and fill in values
# These override config.json when set

# Telegram Bot (rotate via @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Earnings Bot (optional, separate bot)
# EARNINGS_BOT_TOKEN=your_earnings_bot_token
# EARNINGS_CHAT_ID=your_earnings_chat_id

# API Endpoints (override config.json)
# INTEL_API=http://192.168.10.60:3000
# OPTIONS_API=http://192.168.10.60:8000
