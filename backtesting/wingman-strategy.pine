//@version=5
strategy("Wingman Strategy Backtest", overlay=true,
         initial_capital=20000,
         default_qty_type=strategy.percent_of_equity,
         default_qty_value=100,
         commission_type=strategy.commission.percent,
         commission_value=0.05,
         slippage=2,
         pyramiding=0)

// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║                     WINGMAN STRATEGY - BACKTESTING VERSION                    ║
// ║           Tests the VWAP Reversion strategy with ATR-based stops              ║
// ╚══════════════════════════════════════════════════════════════════════════════╝

// ============================================================================
// INPUTS
// ============================================================================

grp_strat = "═══ STRATEGY SETTINGS ═══"
i_strategy = input.string("VWAP Reversion", "Strategy", options=["VWAP Reversion", "MA Reversion", "Range Fade"], group=grp_strat)
i_direction = input.string("Both", "Trade Direction", options=["Long Only", "Short Only", "Both"], group=grp_strat)

grp_risk = "═══ RISK SETTINGS ═══"
i_riskPercent = input.float(1.0, "Risk Per Trade (%)", minval=0.5, maxval=3.0, step=0.5, group=grp_risk)
i_atrPeriod = input.int(10, "ATR Period", minval=5, maxval=20, group=grp_risk)
i_atrMult = input.float(2.0, "ATR Multiplier for Stop", minval=1.0, maxval=4.0, step=0.5, group=grp_risk)
i_targetMult = input.float(1.5, "Target Multiplier (R:R)", minval=1.0, maxval=5.0, step=0.5, group=grp_risk)

grp_vwap = "═══ VWAP SETTINGS ═══"
i_vwapInner = input.float(1.5, "Inner Band (ATR)", minval=1.0, maxval=2.5, step=0.1, group=grp_vwap)
i_vwapOuter = input.float(2.5, "Outer Band (ATR)", minval=2.0, maxval=4.0, step=0.1, group=grp_vwap)

grp_filter = "═══ FILTERS ═══"
i_useVolumeFilter = input.bool(true, "Require Volume Spike", group=grp_filter)
i_volumeMult = input.float(1.5, "Volume Spike Multiplier", minval=1.0, maxval=3.0, step=0.5, group=grp_filter)
i_useRSIFilter = input.bool(true, "Use RSI Filter", group=grp_filter)
i_rsiOversold = input.int(30, "RSI Oversold", minval=20, maxval=40, group=grp_filter)
i_rsiOverbought = input.int(70, "RSI Overbought", minval=60, maxval=80, group=grp_filter)
i_useTrendFilter = input.bool(true, "Use Trend Filter", group=grp_filter)

grp_time = "═══ TIME FILTERS ═══"
i_useTimeFilter = input.bool(true, "Use Time Filter", group=grp_time)
i_startHour = input.int(9, "Start Hour (ET)", minval=0, maxval=23, group=grp_time)
i_startMin = input.int(45, "Start Minute", minval=0, maxval=59, group=grp_time)
i_endHour = input.int(15, "End Hour (ET)", minval=0, maxval=23, group=grp_time)
i_endMin = input.int(45, "End Minute", minval=0, maxval=59, group=grp_time)
i_avoidLunch = input.bool(true, "Avoid Lunch Hour (11:30-13:30)", group=grp_time)

// ============================================================================
// CALCULATIONS
// ============================================================================

// ATR
atr = ta.atr(i_atrPeriod)

// VWAP & Bands
vwapValue = ta.vwap(hlc3)
vwapUpperInner = vwapValue + (atr * i_vwapInner)
vwapLowerInner = vwapValue - (atr * i_vwapInner)
vwapUpperOuter = vwapValue + (atr * i_vwapOuter)
vwapLowerOuter = vwapValue - (atr * i_vwapOuter)

// Zone Detection
inBuyZone = close <= vwapLowerInner and close >= vwapLowerOuter
inSellZone = close >= vwapUpperInner and close <= vwapUpperOuter

// RSI
rsi = ta.rsi(close, 14)
rsiOversold = rsi < i_rsiOversold
rsiOverbought = rsi > i_rsiOverbought

// Volume
volSMA = ta.sma(volume, 20)
volumeSpike = volume > volSMA * i_volumeMult

// Trend (Daily EMA)
dailyEMA = request.security(syminfo.tickerid, "D", ta.ema(close, 20)[1], lookahead=barmerge.lookahead_on)
dailyTrendBull = close > dailyEMA

// Time Filter
currentHour = hour(time, "America/New_York")
currentMin = minute(time, "America/New_York")
currentTime = currentHour * 100 + currentMin
startTime = i_startHour * 100 + i_startMin
endTime = i_endHour * 100 + i_endMin
inLunchHour = currentHour >= 11 and currentHour < 14 and currentMin >= 30

inTradingHours = i_useTimeFilter ?
    (currentTime >= startTime and currentTime <= endTime and (not i_avoidLunch or not inLunchHour)) : true

// ============================================================================
// ENTRY CONDITIONS
// ============================================================================

// Volume condition
volumeCondition = i_useVolumeFilter ? volumeSpike : true

// RSI condition
rsiLongCondition = i_useRSIFilter ? rsiOversold : true
rsiShortCondition = i_useRSIFilter ? rsiOverbought : true

// Trend condition
trendLongCondition = i_useTrendFilter ? dailyTrendBull : true
trendShortCondition = i_useTrendFilter ? not dailyTrendBull : true

// Combined entry conditions
longCondition = inBuyZone and
                volumeCondition and
                rsiLongCondition and
                trendLongCondition and
                inTradingHours and
                (i_direction == "Long Only" or i_direction == "Both")

shortCondition = inSellZone and
                 volumeCondition and
                 rsiShortCondition and
                 trendShortCondition and
                 inTradingHours and
                 (i_direction == "Short Only" or i_direction == "Both")

// ============================================================================
// POSITION SIZING
// ============================================================================

riskAmount = strategy.equity * (i_riskPercent / 100)
stopDistance = atr * i_atrMult
positionSize = stopDistance > 0 ? math.floor(riskAmount / stopDistance) : 0

// ============================================================================
// ENTRY & EXIT LOGIC
// ============================================================================

// Track if we have a position
inLong = strategy.position_size > 0
inShort = strategy.position_size < 0

// Calculate stops and targets
var float longStop = na
var float longTarget = na
var float shortStop = na
var float shortTarget = na

// Long Entry
if longCondition and not inLong and not inShort
    longStop := close - stopDistance
    longTarget := vwapValue  // Target is VWAP
    strategy.entry("Long", strategy.long, qty=positionSize)
    strategy.exit("Long Exit", "Long", stop=longStop, limit=longTarget)

// Short Entry
if shortCondition and not inShort and not inLong
    shortStop := close + stopDistance
    shortTarget := vwapValue  // Target is VWAP
    strategy.entry("Short", strategy.short, qty=positionSize)
    strategy.exit("Short Exit", "Short", stop=shortStop, limit=shortTarget)

// ============================================================================
// PLOTTING
// ============================================================================

// VWAP & Bands
plot(vwapValue, "VWAP", color=color.white, linewidth=2)
plot(vwapUpperInner, "Upper Inner", color=color.new(color.red, 60))
plot(vwapLowerInner, "Lower Inner", color=color.new(color.green, 60))
plot(vwapUpperOuter, "Upper Outer", color=color.new(color.red, 40), style=plot.style_circles)
plot(vwapLowerOuter, "Lower Outer", color=color.new(color.green, 40), style=plot.style_circles)

// Zone fills
p1 = plot(vwapLowerInner, display=display.none)
p2 = plot(vwapLowerOuter, display=display.none)
p3 = plot(vwapUpperInner, display=display.none)
p4 = plot(vwapUpperOuter, display=display.none)
fill(p1, p2, color=color.new(color.green, 90))
fill(p3, p4, color=color.new(color.red, 90))

// Entry signals
plotshape(longCondition and not inLong, "Long Signal", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(shortCondition and not inShort, "Short Signal", shape.triangledown, location.abovebar, color.red, size=size.small)

// ============================================================================
// PERFORMANCE TABLE
// ============================================================================

var table perfTable = table.new(position.top_right, 2, 8, bgcolor=color.new(color.black, 80))

if barstate.islast
    winRate = strategy.wintrades / (strategy.wintrades + strategy.losstrades) * 100
    profitFactor = strategy.grossprofit / math.max(strategy.grossloss, 1)
    avgWin = strategy.grossprofit / math.max(strategy.wintrades, 1)
    avgLoss = strategy.grossloss / math.max(strategy.losstrades, 1)

    table.cell(perfTable, 0, 0, "BACKTEST", bgcolor=color.blue, text_color=color.white)
    table.cell(perfTable, 1, 0, "RESULTS", bgcolor=color.blue, text_color=color.white)

    table.cell(perfTable, 0, 1, "Net Profit", text_color=color.gray)
    table.cell(perfTable, 1, 1, "$" + str.tostring(strategy.netprofit, "#.##"), text_color=strategy.netprofit > 0 ? color.green : color.red)

    table.cell(perfTable, 0, 2, "Win Rate", text_color=color.gray)
    table.cell(perfTable, 1, 2, str.tostring(winRate, "#.#") + "%", text_color=winRate > 50 ? color.green : color.red)

    table.cell(perfTable, 0, 3, "Profit Factor", text_color=color.gray)
    table.cell(perfTable, 1, 3, str.tostring(profitFactor, "#.##"), text_color=profitFactor > 1.5 ? color.green : color.orange)

    table.cell(perfTable, 0, 4, "Total Trades", text_color=color.gray)
    table.cell(perfTable, 1, 4, str.tostring(strategy.closedtrades), text_color=color.white)

    table.cell(perfTable, 0, 5, "Avg Win", text_color=color.gray)
    table.cell(perfTable, 1, 5, "$" + str.tostring(avgWin, "#.##"), text_color=color.green)

    table.cell(perfTable, 0, 6, "Avg Loss", text_color=color.gray)
    table.cell(perfTable, 1, 6, "$" + str.tostring(avgLoss, "#.##"), text_color=color.red)

    table.cell(perfTable, 0, 7, "Max DD", text_color=color.gray)
    table.cell(perfTable, 1, 7, str.tostring(strategy.max_drawdown_percent, "#.#") + "%", text_color=color.orange)
